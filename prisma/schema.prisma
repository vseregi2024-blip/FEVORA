generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVING_IN
  SAVING_OUT
  ADJUSTMENT
}

enum FinanceModule {
  GENERAL
  FAMILY
  POULTRY
}

enum TransactionSource {
  WEB
  TELEGRAM
}

enum CategoryKind {
  INCOME
  EXPENSE
  BOTH
}

enum RecurringFrequency {
  MONTHLY
  WEEKLY
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  passwordHash    String
  timezone        String        @default("Europe/Kyiv")
  defaultCurrency String        @default("UAH") @db.Char(3)
  startingBalance Decimal       @default(0) @db.Decimal(18, 2)
  transactions    Transaction[]
  categories      Category[]
  receipts        Receipt[]
  recurringPayments RecurringPayment[]
  savingsGoals    SavingsGoal[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Category {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     FinanceModule @default(GENERAL)
  name       String
  icon       String?
  kind       CategoryKind  @default(BOTH)
  sortOrder  Int           @default(0)
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  transactions Transaction[]
  recurringPayments RecurringPayment[]

  @@unique([userId, module, name])
  @@index([module, isArchived])
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @default("UAH") @db.Char(3)
  operationDate DateTime          @db.Date
  categoryId    String?
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  module        FinanceModule     @default(GENERAL)
  description   String?
  source        TransactionSource @default(WEB)
  receiptId     String?
  receipt       Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  savingsMovement SavingsMovement?
  recurringPaymentId String?
  recurringPayment RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([userId, operationDate])
  @@index([userId, deletedAt])
  @@index([categoryId])
  @@index([receiptId])
  @@index([recurringPaymentId])
}

model Receipt {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String?
  operationDate DateTime      @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  transactions  Transaction[]

  @@index([userId, operationDate])
}

model RecurringPayment {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("UAH") @db.Char(3)
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency   RecurringFrequency @default(MONTHLY)
  nextDueDate DateTime          @db.Date
  isActive    Boolean           @default(true)
  note        String?
  transactions Transaction[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, isActive, nextDueDate])
}

model SavingsGoal {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal?          @db.Decimal(18, 2)
  status       SavingsGoalStatus @default(ACTIVE)
  note         String?
  movements    SavingsMovement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, status])
}

model SavingsMovement {
  id            String          @id @default(cuid())
  goalId        String
  goal          SavingsGoal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transactionId String          @unique
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  direction     TransactionType
  amount        Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())

  @@index([goalId, createdAt])
}
