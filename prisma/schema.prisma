generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVING_IN
  SAVING_OUT
  ADJUSTMENT
}

enum FinanceModule {
  GENERAL
  FAMILY
  POULTRY
}

enum TransactionSource {
  WEB
  TELEGRAM
}

enum CategoryKind {
  INCOME
  EXPENSE
  BOTH
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  passwordHash    String
  timezone        String        @default("Europe/Kyiv")
  defaultCurrency String        @default("UAH") @db.Char(3)
  startingBalance Decimal       @default(0) @db.Decimal(18, 2)
  transactions    Transaction[]
  categories      Category[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Category {
  id         String        @id @default(cuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     FinanceModule @default(GENERAL)
  name       String
  icon       String?
  kind       CategoryKind  @default(BOTH)
  sortOrder  Int           @default(0)
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  transactions Transaction[]

  @@unique([userId, module, name])
  @@index([module, isArchived])
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @default("UAH") @db.Char(3)
  operationDate DateTime          @db.Date
  categoryId    String?
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  module        FinanceModule     @default(GENERAL)
  description   String?
  source        TransactionSource @default(WEB)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([userId, operationDate])
  @@index([userId, deletedAt])
  @@index([categoryId])
}
