generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVING_IN
  SAVING_OUT
  ADJUSTMENT
}

enum FinanceModule {
  GENERAL
  FAMILY
  POULTRY
  GOODS
  INFOBUSINESS
  COSMETOLOGY
}

enum ProductUnit {
  PIECE
  PACKAGE
  JAR
  BOTTLE
  OTHER
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum InfoProductFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum InfoProductStatus {
  PREPARATION
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProductInventoryMovementType {
  PURCHASE
  SALE
  WRITE_OFF
  ADJUSTMENT
}

enum TransactionSource {
  WEB
  TELEGRAM
}

enum CategoryKind {
  INCOME
  EXPENSE
  BOTH
}

enum RecurringFrequency {
  MONTHLY
  WEEKLY
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PoultryBatchStatus {
  ACTIVE
  COMPLETED
}

enum PoultryBatchSource {
  INCUBATION
  PURCHASE
  GIFT
  OTHER
}

enum PoultryMovementType {
  ADD
  SALE
  MORTALITY
  FAMILY_USE
  TRANSFER
  ADJUSTMENT
}

enum PoultrySaleType {
  LIVE_BIRD
  CARCASS
  EGGS
  OTHER
}

enum PoultrySlaughterPurpose {
  FAMILY
  SALE
}

enum PoultryOriginType {
  INCUBATION
  PURCHASE
  GIFT
  OTHER
}

enum PoultryCostEntryType {
  ACQUISITION
  INCUBATION_EGGS
  TRANSFER_IN
  TRANSFER_OUT
  MANUAL
}

enum IncubationEggSource {
  OWN
  PURCHASED
  GIFTED
}

enum FeedUnit {
  KG
  BAG
  HOUSEHOLD
}

enum FeedAdjustmentType {
  RECONCILIATION
  CORRECTION
}

enum IncubationStatus {
  ACTIVE
  COMPLETED
}

enum FeedUsageType {
  ASSIGNED
  FINISHED
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  name                       String?
  passwordHash               String
  timezone                   String                      @default("Europe/Kyiv")
  defaultCurrency            String                      @default("UAH") @db.Char(3)
  startingBalance            Decimal                     @default(0) @db.Decimal(18, 2)
  transactions               Transaction[]
  categories                 Category[]
  receipts                   Receipt[]
  recurringPayments          RecurringPayment[]
  savingsGoals               SavingsGoal[]
  poultryBatches             PoultryBatch[]
  poultryMovements           PoultryMovement[]
  incubationBatches          IncubationBatch[]
  feedProducts               FeedProduct[]
  feedLots                   FeedLot[]
  poultrySales               PoultrySale[]
  poultryOperationalExpenses PoultryOperationalExpense[]
  poultryOrigins             PoultryOrigin[]
  poultryTransfers           PoultryTransfer[]
  poultrySlaughters          PoultrySlaughter[]
  poultryEggCollections      PoultryEggCollection[]
  poultryCostEntries         PoultryCostEntry[]
  feedRates                  FeedRate[]
  feedAdjustments            FeedInventoryAdjustment[]
  productCategories          ProductCategory[]
  products                   Product[]
  productPurchases           ProductPurchase[]
  productSales               ProductSale[]
  productInventoryLots       ProductInventoryLot[]
  productInventoryMovements  ProductInventoryMovement[]
  goodsOperationalExpenses   GoodsOperationalExpense[]
  infoProducts               InfoProduct[]
  infoSales                  InfoSale[]
  infoExpenseCategories      InfoExpenseCategory[]
  infoExpenses               InfoExpense[]
  cosmetologyClients         CosmetologyClient[]
  cosmetologyProcedureTemplates CosmetologyProcedureTemplate[]
  cosmetologyInventoryItems  CosmetologyInventoryItem[]
  cosmetologyInventoryLots   CosmetologyInventoryLot[]
  cosmetologyInventoryMovements CosmetologyInventoryMovement[]
  cosmetologyVisits          CosmetologyVisit[]
  cosmetologyExpenseCategories CosmetologyExpenseCategory[]
  cosmetologyExpenses        CosmetologyExpense[]
  cosmetologyWalletMovements CosmetologyWalletMovement[]
  poultryBreeds             PoultryBreed[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model Category {
  id                String             @id @default(cuid())
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  module            FinanceModule      @default(GENERAL)
  name              String
  icon              String?
  kind              CategoryKind       @default(BOTH)
  sortOrder         Int                @default(0)
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transactions      Transaction[]
  recurringPayments RecurringPayment[]

  @@unique([userId, module, name])
  @@index([module, isArchived])
}

model Transaction {
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               TransactionType
  amount             Decimal                    @db.Decimal(18, 2)
  currency           String                     @default("UAH") @db.Char(3)
  operationDate      DateTime                   @db.Date
  categoryId         String?
  category           Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  module             FinanceModule              @default(GENERAL)
  description        String?
  source             TransactionSource          @default(WEB)
  receiptId          String?
  receipt            Receipt?                   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  savingsMovement    SavingsMovement?
  recurringPaymentId String?
  recurringPayment   RecurringPayment?          @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)
  poultrySale        PoultrySale?               @relation("SaleIncome")
  feedLot            FeedLot?                   @relation("FeedPurchaseExpense")
  operationalExpense PoultryOperationalExpense?
  poultryAcquisition PoultryBatch?              @relation("PoultryAcquisitionExpense")
  incubationPurchase IncubationBatch?           @relation("IncubationEggExpense")
  productPurchase    ProductPurchase?           @relation("ProductPurchaseExpense")
  productSale        ProductSale?               @relation("ProductSaleIncome")
  goodsExpense       GoodsOperationalExpense?
  infoSale           InfoSale?                  @relation("InfoSaleIncome")
  infoExpense        InfoExpense?               @relation("InfoExpenseTransaction")
  cosmetologyVisit   CosmetologyVisit?           @relation("CosmetologyVisitIncome")
  cosmetologyLot     CosmetologyInventoryLot?    @relation("CosmetologyLotExpense")
  cosmetologyExpense CosmetologyExpense?         @relation("CosmetologyExpenseTransaction")
  cosmetologyWalletMovement CosmetologyWalletMovement? @relation("CosmetologyWalletMovementTransaction")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deletedAt          DateTime?

  @@unique([recurringPaymentId, operationDate])
  @@index([userId, operationDate])
  @@index([userId, deletedAt])
  @@index([categoryId])
  @@index([receiptId])
  @@index([recurringPaymentId])
}

model PoultryBatch {
  id                         String                      @id @default(cuid())
  userId                     String
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String
  birdType                   String
  breed                      String?
  startDate                  DateTime                    @db.Date
  acquisitionDate            DateTime?                   @db.Date
  ageAtAcquisitionDays       Int?
  startingQuantity           Int
  currentQuantity            Int
  source                     PoultryBatchSource
  status                     PoultryBatchStatus          @default(ACTIVE)
  comment                    String?
  incubationBatchId          String?
  incubationBatch            IncubationBatch?            @relation(fields: [incubationBatchId], references: [id], onDelete: SetNull)
  incubationItemId           String?                     @unique
  incubationItem             IncubationBatchItem?        @relation(fields: [incubationItemId], references: [id], onDelete: SetNull)
  acquisitionCashCost        Decimal                     @default(0) @db.Decimal(18, 2)
  acquisitionProductionCost  Decimal                     @default(0) @db.Decimal(18, 2)
  acquisitionTransactionId   String?                     @unique
  acquisitionTransaction     Transaction?                @relation("PoultryAcquisitionExpense", fields: [acquisitionTransactionId], references: [id], onDelete: Restrict)
  movements                  PoultryMovement[]
  feedUsages                 FeedUsage[]
  feedRates                  FeedRate[]
  sales                      PoultrySale[]
  breeds                     PoultryBatchBreed[]
  originMovements            PoultryOriginMovement[]
  sourceTransfers            PoultryTransfer[]           @relation("TransferSource")
  destinationTransfers       PoultryTransfer[]           @relation("TransferDestination")
  slaughters                 PoultrySlaughter[]
  eggCollections             PoultryEggCollection[]
  costEntries                PoultryCostEntry[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  poultryOperationalExpenses PoultryOperationalExpense[]

  @@index([userId, status, deletedAt])
}

model PoultryMovement {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId         String
  batch           PoultryBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type            PoultryMovementType
  quantity        Int
  quantityDelta   Int?
  operationDate   DateTime                @db.Date
  reason          String?
  comment         String?
  saleId          String?                 @unique
  sale            PoultrySale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  transferId      String?
  transfer        PoultryTransfer?        @relation(fields: [transferId], references: [id], onDelete: SetNull)
  slaughter       PoultrySlaughter?
  originMovements PoultryOriginMovement[]
  createdAt       DateTime                @default(now())
  deletedAt       DateTime?

  @@index([userId, batchId, operationDate])
}

model IncubationBatch {
  id                   String                      @id @default(cuid())
  userId               String
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  setDate              DateTime                    @db.Date
  birdType             String
  eggSource            IncubationEggSource         @default(OWN)
  cashCost             Decimal                     @default(0) @db.Decimal(18, 2)
  productionCost       Decimal                     @default(0) @db.Decimal(18, 2)
  hatchDate            DateTime?                   @db.Date
  expenseTransactionId String?                     @unique
  expenseTransaction   Transaction?                @relation("IncubationEggExpense", fields: [expenseTransactionId], references: [id], onDelete: Restrict)
  status               IncubationStatus            @default(ACTIVE)
  comment              String?
  items                IncubationBatchItem[]
  poultryBatches       PoultryBatch[]
  operationalExpenses  PoultryOperationalExpense[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?

  @@index([userId, status, deletedAt])
}

model IncubationBatchItem {
  id                String          @id @default(cuid())
  incubationBatchId String
  incubationBatch   IncubationBatch @relation(fields: [incubationBatchId], references: [id], onDelete: Cascade)
  poultryBatch      PoultryBatch?
  breed             String?
  setQuantity       Int
  infertileQuantity Int             @default(0)
  lossQuantity      Int             @default(0)
  hatchedQuantity   Int             @default(0)
  comment           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([incubationBatchId])
}

model FeedProduct {
  id                String                    @id @default(cuid())
  userId            String
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  type              String?
  bagSizeKg         Decimal?                  @db.Decimal(10, 2)
  householdUnitName String?
  householdUnitKg   Decimal?                  @db.Decimal(10, 3)
  minimumStockKg    Decimal                   @default(25) @db.Decimal(14, 3)
  lots              FeedLot[]
  rates             FeedRate[]
  adjustments       FeedInventoryAdjustment[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([userId, name])
}

model FeedLot {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId             String
  product               FeedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseTransactionId String      @unique
  purchaseTransaction   Transaction @relation("FeedPurchaseExpense", fields: [purchaseTransactionId], references: [id], onDelete: Cascade)
  purchasedBags         Int
  availableBags         Int
  costPerBag            Decimal     @db.Decimal(18, 2)
  purchaseUnit          FeedUnit    @default(BAG)
  purchaseQuantity      Decimal?    @db.Decimal(14, 3)
  purchasedKg           Decimal?    @db.Decimal(14, 3)
  availableKg           Decimal?    @db.Decimal(14, 3)
  costPerKg             Decimal?    @db.Decimal(18, 4)
  purchaseDate          DateTime    @db.Date
  deliveryAmount       Decimal     @default(0) @db.Decimal(18, 2)
  supplier             String?
  comment               String?
  usages                FeedUsage[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  @@index([userId, productId, deletedAt])
}

model FeedUsage {
  id            String        @id @default(cuid())
  lotId         String
  lot           FeedLot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         PoultryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  bags          Int
  unit          FeedUnit      @default(BAG)
  quantity      Decimal?      @db.Decimal(14, 3)
  quantityKg    Decimal?      @db.Decimal(14, 3)
  costAmount    Decimal?      @db.Decimal(18, 2)
  type          FeedUsageType @default(ASSIGNED)
  operationDate DateTime      @db.Date
  purpose       String?
  comment       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([lotId, batchId])
}

model PoultrySale {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId             String?
  batch               PoultryBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  saleType            PoultrySaleType   @default(LIVE_BIRD)
  buyer               String?
  buyerPhone          String?
  itemName            String
  quantity            Int?
  weightKg            Decimal?          @db.Decimal(10, 3)
  price               Decimal?          @db.Decimal(18, 2)
  totalAmount         Decimal           @db.Decimal(18, 2)
  operationDate       DateTime          @db.Date
  comment             String?
  incomeTransactionId String            @unique
  incomeTransaction   Transaction       @relation("SaleIncome", fields: [incomeTransactionId], references: [id], onDelete: Cascade)
  movement            PoultryMovement?
  slaughterId         String?           @unique
  slaughter           PoultrySlaughter? @relation(fields: [slaughterId], references: [id], onDelete: SetNull)
  autoSlaughter       Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@index([userId, operationDate, deletedAt])
}

model PoultryOperationalExpense {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId     String           @unique
  transaction       Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             PoultryBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  incubationBatchId String?
  incubationBatch   IncubationBatch? @relation(fields: [incubationBatchId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
}

model PoultryBatchBreed {
  id        String       @id @default(cuid())
  batchId   String
  batch     PoultryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([batchId, deletedAt])
}

model PoultryBreed {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, isArchived, sortOrder])
}

model PoultryOrigin {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PoultryOriginType
  birdType        String
  originDate      DateTime                @db.Date
  initialQuantity Int
  description     String?
  movements       PoultryOriginMovement[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  @@index([userId, originDate, deletedAt])
}

model PoultryOriginMovement {
  id            String           @id @default(cuid())
  originId      String
  origin        PoultryOrigin    @relation(fields: [originId], references: [id], onDelete: Cascade)
  batchId       String
  batch         PoultryBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  movementId    String?
  movement      PoultryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  quantityDelta Int
  operationDate DateTime         @db.Date
  createdAt     DateTime         @default(now())
  deletedAt     DateTime?

  @@index([originId, batchId, deletedAt])
  @@index([movementId])
}

model PoultryTransfer {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceBatchId      String
  sourceBatch        PoultryBatch      @relation("TransferSource", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  destinationBatchId String
  destinationBatch   PoultryBatch      @relation("TransferDestination", fields: [destinationBatchId], references: [id], onDelete: Restrict)
  quantity           Int
  transferredCost    Decimal           @db.Decimal(18, 2)
  operationDate      DateTime          @db.Date
  comment            String?
  movements          PoultryMovement[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  @@index([userId, operationDate, deletedAt])
  @@index([sourceBatchId, destinationBatchId])
}

model PoultryCostEntry {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId       String
  batch         PoultryBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type          PoultryCostEntryType
  amount        Decimal              @db.Decimal(18, 2)
  referenceId   String?
  operationDate DateTime             @db.Date
  comment       String?
  createdAt     DateTime             @default(now())
  deletedAt     DateTime?

  @@index([batchId, operationDate, deletedAt])
  @@index([referenceId])
}

model PoultrySlaughter {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId         String
  batch           PoultryBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity        Int
  purpose         PoultrySlaughterPurpose
  carcassWeightKg Decimal?                @db.Decimal(10, 3)
  operationDate   DateTime                @db.Date
  comment         String?
  movementId      String                  @unique
  movement        PoultryMovement         @relation(fields: [movementId], references: [id], onDelete: Restrict)
  sale            PoultrySale?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  @@index([userId, operationDate, deletedAt])
}

model PoultryEggCollection {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         PoultryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  breed         String?
  quantity      Int
  operationDate DateTime      @db.Date
  collector     String?
  comment       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([userId, operationDate, deletedAt])
  @@index([batchId, operationDate])
}

model FeedRate {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId       String
  batch         PoultryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId     String
  product       FeedProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dailyQuantity Decimal      @db.Decimal(14, 3)
  unit          FeedUnit
  dailyKg       Decimal      @db.Decimal(14, 3)
  effectiveFrom DateTime     @db.Date
  comment       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([batchId, productId, effectiveFrom, deletedAt])
}

model FeedInventoryAdjustment {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         FeedProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            FeedAdjustmentType @default(RECONCILIATION)
  calculatedKg    Decimal            @db.Decimal(14, 3)
  actualKg        Decimal            @db.Decimal(14, 3)
  quantityDeltaKg Decimal            @db.Decimal(14, 3)
  operationDate   DateTime           @db.Date
  comment         String?
  createdAt       DateTime           @default(now())
  deletedAt       DateTime?

  @@index([userId, productId, operationDate, deletedAt])
}

model ProductCategory {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int       @default(0)
  isArchived Boolean   @default(false)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, name])
  @@index([isArchived, sortOrder])
}

model Product {
  id               String                     @id @default(cuid())
  userId           String
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  categoryId       String?
  category         ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            String?
  unit             ProductUnit                @default(PIECE)
  currentQuantity  Int                        @default(0)
  defaultSalePrice Decimal?                   @db.Decimal(18, 2)
  status           ProductStatus              @default(ACTIVE)
  comment          String?
  purchases        ProductPurchase[]
  sales            ProductSale[]
  inventoryLots    ProductInventoryLot[]
  movements        ProductInventoryMovement[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deletedAt        DateTime?

  @@unique([userId, name])
  @@index([userId, status, deletedAt])
}

model ProductPurchase {
  id                   String                    @id @default(cuid())
  userId               String
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId            String
  product              Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity             Int
  unitPurchasePrice    Decimal                   @db.Decimal(18, 2)
  deliveryAmount       Decimal                   @default(0) @db.Decimal(18, 2)
  deliveryInCost       Boolean                   @default(false)
  totalAmount          Decimal                   @db.Decimal(18, 2)
  supplier             String?
  operationDate        DateTime                  @db.Date
  comment              String?
  expenseTransactionId String                    @unique
  expenseTransaction   Transaction               @relation("ProductPurchaseExpense", fields: [expenseTransactionId], references: [id], onDelete: Cascade)
  deliveryExpense      GoodsOperationalExpense?  @relation("PurchaseDeliveryExpense")
  inventoryLot         ProductInventoryLot?
  inventoryMovement    ProductInventoryMovement? @relation("PurchaseMovement")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deletedAt            DateTime?

  @@index([userId, productId, operationDate, deletedAt])
}

model ProductInventoryLot {
  id                   String                       @id @default(cuid())
  userId               String
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId            String
  product              Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseId           String?                      @unique
  purchase             ProductPurchase?             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  adjustmentMovementId String?                      @unique
  adjustmentMovement   ProductInventoryMovement?    @relation("AdjustmentLot", fields: [adjustmentMovementId], references: [id], onDelete: Cascade)
  initialQuantity      Int
  availableQuantity    Int
  unitCost             Decimal                      @db.Decimal(18, 2)
  receivedDate         DateTime                     @db.Date
  comment              String?
  allocations          ProductInventoryAllocation[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?

  @@index([userId, productId, receivedDate, deletedAt])
}

model ProductSale {
  id                  String                       @id @default(cuid())
  userId              String
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity            Int
  unitSalePrice       Decimal                      @db.Decimal(18, 2)
  totalAmount         Decimal                      @db.Decimal(18, 2)
  costOfGoods         Decimal                      @db.Decimal(18, 2)
  profitAmount        Decimal                      @db.Decimal(18, 2)
  buyer               String?
  operationDate       DateTime                     @db.Date
  comment             String?
  incomeTransactionId String                       @unique
  incomeTransaction   Transaction                  @relation("ProductSaleIncome", fields: [incomeTransactionId], references: [id], onDelete: Cascade)
  inventoryMovement   ProductInventoryMovement?    @relation("SaleMovement")
  allocations         ProductInventoryAllocation[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  deletedAt           DateTime?

  @@index([userId, productId, operationDate, deletedAt])
}

model ProductInventoryMovement {
  id            String                       @id @default(cuid())
  userId        String
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          ProductInventoryMovementType
  quantity      Int
  operationDate DateTime                     @db.Date
  comment       String?
  purchaseId    String?                      @unique
  purchase      ProductPurchase?             @relation("PurchaseMovement", fields: [purchaseId], references: [id], onDelete: Cascade)
  saleId        String?                      @unique
  sale          ProductSale?                 @relation("SaleMovement", fields: [saleId], references: [id], onDelete: Cascade)
  adjustmentLot ProductInventoryLot?         @relation("AdjustmentLot")
  allocations   ProductInventoryAllocation[]
  createdAt     DateTime                     @default(now())
  deletedAt     DateTime?

  @@index([userId, productId, operationDate, deletedAt])
}

model ProductInventoryAllocation {
  id         String                   @id @default(cuid())
  lotId      String
  lot        ProductInventoryLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  movementId String
  movement   ProductInventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       ProductSale?             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  quantity   Int
  unitCost   Decimal                  @db.Decimal(18, 2)
  totalCost  Decimal                  @db.Decimal(18, 2)
  createdAt  DateTime                 @default(now())
  deletedAt  DateTime?

  @@index([lotId, deletedAt])
  @@index([movementId, deletedAt])
  @@index([saleId, deletedAt])
}

model GoodsOperationalExpense {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String           @unique
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  purchaseId    String?          @unique
  purchase      ProductPurchase? @relation("PurchaseDeliveryExpense", fields: [purchaseId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
}

model InfoProduct {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  format    InfoProductFormat
  basePrice Decimal?          @db.Decimal(18, 2)
  startDate DateTime?         @db.Date
  endDate   DateTime?         @db.Date
  status    InfoProductStatus @default(ACTIVE)
  comment   String?
  sales     InfoSale[]
  expenses  InfoExpense[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  @@unique([userId, name])
  @@index([userId, status, deletedAt])
}

model InfoSale {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             InfoProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer               String?
  buyerPhone          String?
  buyerEmail          String?
  instagramUrl        String?
  seats               Int         @default(1)
  comment             String?
  incomeTransactionId String      @unique
  incomeTransaction   Transaction @relation("InfoSaleIncome", fields: [incomeTransactionId], references: [id], onDelete: Cascade)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  @@index([userId, productId, deletedAt])
}

model InfoExpenseCategory {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int           @default(0)
  isArchived Boolean       @default(false)
  expenses   InfoExpense[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, name])
  @@index([userId, isArchived, sortOrder])
}

model InfoExpense {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String              @unique
  transaction   Transaction         @relation("InfoExpenseTransaction", fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      InfoExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productId     String?
  product       InfoProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceName   String?
  comment       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([userId, productId, categoryId, deletedAt])
}

model Receipt {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String?
  operationDate DateTime      @db.Date
  totalAmount   Decimal       @default(0) @db.Decimal(18, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  transactions  Transaction[]

  @@index([userId, operationDate])
}

model RecurringPayment {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal            @db.Decimal(18, 2)
  currency     String             @default("UAH") @db.Char(3)
  categoryId   String?
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency    RecurringFrequency @default(MONTHLY)
  nextDueDate  DateTime           @db.Date
  endDate      DateTime?          @db.Date
  isActive     Boolean            @default(true)
  archivedAt   DateTime?
  note         String?
  transactions Transaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, isActive, nextDueDate])
  @@index([userId, archivedAt])
}

model SavingsGoal {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal?          @db.Decimal(18, 2)
  status       SavingsGoalStatus @default(ACTIVE)
  note         String?
  movements    SavingsMovement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, status])
}

model SavingsMovement {
  id            String          @id @default(cuid())
  goalId        String
  goal          SavingsGoal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transactionId String          @unique
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  direction     TransactionType
  amount        Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())

  @@index([goalId, createdAt])
}

enum CosmetologyUnit {
  UNIT
  ML
  VIAL
  SYRINGE
  PACKAGE
  PIECE
  PAIR
  OTHER
}

enum CosmetologyInventoryMovementType {
  PURCHASE
  PROCEDURE_USE
  WRITE_OFF
  ADJUSTMENT
}

enum CosmetologyClientStatus {
  NEW
  REGULAR
  VIP
  POTENTIAL
  INACTIVE
}

enum CosmetologyContactMethod {
  PHONE
  VIBER
  WHATSAPP
  TELEGRAM
  INSTAGRAM
  TIKTOK
}

enum CosmetologyPlanStatus {
  RECOMMENDED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CosmetologyVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CosmetologyWallet {
  CASH
  MONO
  PRIVAT
  PROCUREMENT
}

enum CosmetologyWalletMovementType {
  PREPAYMENT
  SETTLEMENT
  DEBT_PAYMENT
  REFUND
  PURCHASE
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

model CosmetologyClient {
  id                String                   @id @default(cuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastName          String
  firstName         String
  displayName       String?
  phone             String
  phoneLastFour     String
  birthDate         DateTime?                @db.Date
  contactMethod     CosmetologyContactMethod @default(PHONE)
  contactValue      String?
  source            String?
  referrerId        String?
  referrer          CosmetologyClient?           @relation("CosmetologyClientReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals         CosmetologyClient[]           @relation("CosmetologyClientReferrals")
  status            CosmetologyClientStatus  @default(NEW)
  specialMarks      String[]                 @default([])
  notes             String?
  allergies         String?
  contraindications String?
  medicalNotes      String?
  visits            CosmetologyVisit[]
  planItems         CosmetologyTreatmentPlanItem[]
  photos            CosmetologyClientPhoto[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  @@index([userId, lastName, firstName, deletedAt])
  @@index([userId, phoneLastFour, deletedAt])
}

model CosmetologyClientPhoto {
  id        String             @id @default(cuid())
  userId    String
  clientId  String
  client    CosmetologyClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  storageKey String
  kind      String
  note      String?
  createdAt DateTime           @default(now())
  deletedAt DateTime?

  @@index([userId, clientId, deletedAt])
}

model CosmetologyProcedureTemplate {
  id           String                        @id @default(cuid())
  userId       String
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  basePrice    Decimal?                      @db.Decimal(18, 2)
  durationMinutes Int?
  isArchived   Boolean                       @default(false)
  comment      String?
  materials    CosmetologyProcedureMaterialTemplate[]
  visits       CosmetologyVisit[]
  visitServices CosmetologyVisitService[]
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  deletedAt    DateTime?

  @@unique([userId, name])
  @@index([userId, isArchived, deletedAt])
}

model CosmetologyProcedureMaterialTemplate {
  id          String                         @id @default(cuid())
  templateId  String
  template    CosmetologyProcedureTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId      String
  item        CosmetologyInventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Decimal                        @db.Decimal(18, 3)
  createdAt   DateTime                       @default(now())

  @@unique([templateId, itemId])
}

model CosmetologyInventoryItem {
  id           String                         @id @default(cuid())
  userId       String
  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  brand        String?
  unit         CosmetologyUnit                @default(UNIT)
  currentQuantity Decimal                     @default(0) @db.Decimal(18, 3)
  minimumQuantity Decimal                     @default(0) @db.Decimal(18, 3)
  comment      String?
  lots         CosmetologyInventoryLot[]
  movements    CosmetologyInventoryMovement[]
  templateMaterials CosmetologyProcedureMaterialTemplate[]
  usages       CosmetologyProcedureMaterialUsage[]
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  deletedAt    DateTime?

  @@unique([userId, name])
  @@index([userId, category, deletedAt])
}

model CosmetologyInventoryLot {
  id             String                         @id @default(cuid())
  userId         String
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String
  item           CosmetologyInventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  initialQuantity Decimal                       @db.Decimal(18, 3)
  availableQuantity Decimal                     @db.Decimal(18, 3)
  totalAmount    Decimal                        @db.Decimal(18, 2)
  unitCost       Decimal                        @db.Decimal(18, 4)
  purchaseDate   DateTime                       @db.Date
  expiryDate     DateTime?                      @db.Date
  batchNumber    String?
  supplier       String?
  comment        String?
  expenseTransactionId String?                  @unique
  expenseTransaction Transaction?               @relation("CosmetologyLotExpense", fields: [expenseTransactionId], references: [id], onDelete: Cascade)
  usages         CosmetologyProcedureMaterialUsage[]
  movements      CosmetologyInventoryMovement[]
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  deletedAt      DateTime?

  @@index([userId, itemId, purchaseDate, deletedAt])
}

model CosmetologyInventoryMovement {
  id            String                            @id @default(cuid())
  userId        String
  user          User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId        String
  item          CosmetologyInventoryItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotId         String?
  lot           CosmetologyInventoryLot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  visitId       String?
  visit         CosmetologyVisit?                 @relation(fields: [visitId], references: [id], onDelete: SetNull)
  type          CosmetologyInventoryMovementType
  quantity      Decimal                           @db.Decimal(18, 3)
  operationDate DateTime                          @db.Date
  comment       String?
  createdAt     DateTime                          @default(now())
  deletedAt     DateTime?

  @@index([userId, itemId, operationDate, deletedAt])
}

model CosmetologyVisit {
  id                String                           @id @default(cuid())
  userId            String
  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String
  client            CosmetologyClient                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  procedureTemplateId String?
  procedureTemplate CosmetologyProcedureTemplate?    @relation(fields: [procedureTemplateId], references: [id], onDelete: SetNull)
  services          CosmetologyVisitService[]
  procedureName     String
  status            CosmetologyVisitStatus        @default(SCHEDULED)
  scheduledTime     String?
  durationMinutes   Int?
  operationDate     DateTime                         @db.Date
  plannedAmount     Decimal?                         @db.Decimal(18, 2)
  paymentAmount     Decimal                          @db.Decimal(18, 2)
  paidAmount        Decimal                          @default(0) @db.Decimal(18, 2)
  costAmount        Decimal                          @default(0) @db.Decimal(18, 2)
  profitAmount      Decimal                          @default(0) @db.Decimal(18, 2)
  comment           String?
  incomeTransactionId String?                        @unique
  incomeTransaction Transaction?                     @relation("CosmetologyVisitIncome", fields: [incomeTransactionId], references: [id], onDelete: Cascade)
  usages            CosmetologyProcedureMaterialUsage[]
  movements         CosmetologyInventoryMovement[]
  walletMovements   CosmetologyWalletMovement[]
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  deletedAt         DateTime?

  @@index([userId, status, operationDate, deletedAt])
  @@index([userId, clientId, operationDate, deletedAt])
}

model CosmetologyVisitService {
  id              String                        @id @default(cuid())
  visitId         String
  visit           CosmetologyVisit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  templateId      String?
  template        CosmetologyProcedureTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name            String
  price           Decimal                       @default(0) @db.Decimal(18, 2)
  durationMinutes Int?
  sortOrder       Int                           @default(0)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([visitId, sortOrder])
}

model CosmetologyWalletMovement {
  id            String                         @id @default(cuid())
  userId        String
  user          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        CosmetologyWallet
  type          CosmetologyWalletMovementType
  amount        Decimal                        @db.Decimal(18, 2)
  operationDate DateTime                       @db.Date
  description   String?
  visitId       String?
  visit         CosmetologyVisit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  transactionId String?                        @unique
  transaction   Transaction?                   @relation("CosmetologyWalletMovementTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime                       @default(now())
  deletedAt     DateTime?

  @@index([userId, wallet, operationDate, deletedAt])
  @@index([userId, visitId])
}

model CosmetologyProcedureMaterialUsage {
  id        String                    @id @default(cuid())
  visitId   String
  visit     CosmetologyVisit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  itemId    String
  item      CosmetologyInventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotId     String
  lot       CosmetologyInventoryLot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity  Decimal                    @db.Decimal(18, 3)
  unitCost  Decimal                    @db.Decimal(18, 4)
  totalCost Decimal                    @db.Decimal(18, 2)
  createdAt DateTime                   @default(now())
  deletedAt DateTime?

  @@index([visitId, deletedAt])
  @@index([itemId, deletedAt])
}

model CosmetologyExpenseCategory {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int                      @default(0)
  isArchived Boolean                  @default(false)
  expenses   CosmetologyExpense[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([userId, name])
  @@index([userId, isArchived, sortOrder])
}

model CosmetologyExpense {
  id            String                     @id @default(cuid())
  userId        String
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String                     @unique
  transaction   Transaction                @relation("CosmetologyExpenseTransaction", fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      CosmetologyExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comment       String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  deletedAt     DateTime?

  @@index([userId, categoryId, deletedAt])
}

model CosmetologyTreatmentPlanItem {
  id          String                  @id @default(cuid())
  userId      String
  clientId    String
  client      CosmetologyClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  plannedDate DateTime?               @db.Date
  status      CosmetologyPlanStatus   @default(RECOMMENDED)
  note        String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?

  @@index([userId, clientId, status, deletedAt])
}
